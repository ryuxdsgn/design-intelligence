  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "author": "ryux.design",
  "homepage": "https://github.com/ryuxdsgn/design-intelligence#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryuxdsgn/design-intelligence.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ryuxdsgn/design-intelligence/issues"
  },
  "keywords": [
    "ai",
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "design",
    "ux",
    "design-critique",
    "accessibility",
    "anti-slop",
    "indonesia"
  ],
  "engines": {
    "node": ">=20.12"
