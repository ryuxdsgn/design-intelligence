{
  "name": "@ryuxdsgn/ryux",
  "version": "2.3.3",
  "description": "RYUX: design intelligence for AI agents and designers. One skill, five entry points: Analyze, Design, Build, Critique, and QA, for Claude Code, Codex, Cursor, Gemini CLI, OpenCode, Cline, Copilot, and more.",
  "type": "module",
  "bin": {
    "ryux": "dist/cli/index.js",
