+++ b/src/pages/Billing.test.tsx
@@ -0,0 +1,54 @@
+import { fireEvent, render, screen, within } from "@testing-library/react";
+import { Billing } from "./Billing";
+
+function withScenario(name?: string) {
+  window.history.replaceState({}, "", name ? `/?scenario=${name}` : "/");
+}
+
+afterEach(() => withScenario());
+
+test("shows plan, payment method, usage, and invoices", async () => {
+  withScenario();
+  render(<Billing />);
+  expect(await screen.findByText("Team", {}, { timeout: 2000 })).toBeInTheDocument();
+  expect(screen.getByText(/\$96\.00 per month/)).toBeInTheDocument();
+  expect(screen.getByText("Current period: Oct 1, 2026 – Oct 31, 2026")).toBeInTheDocument();
+  expect(screen.getByText("Card ending 4242")).toBeInTheDocument();
+  expect(screen.getByText("412 of 500 GB")).toBeInTheDocument();
+  expect(screen.getByText("7,300 of 10,000 runs")).toBeInTheDocument();
+  expect(within(screen.getByRole("table", { name: "Invoices" })).getAllByRole("row")).toHaveLength(7);
+  expect(screen.queryByRole("alert")).not.toBeInTheDocument();
+});
+
+test("explains a failed payment", async () => {
+  withScenario("payment-failed");
+  render(<Billing />);
+  const alert = await screen.findByRole("alert", {}, { timeout: 2000 });
+  expect(alert).toHaveTextContent("Your last payment failed");
+  expect(alert).toHaveTextContent("We couldn't charge $96.00 to the card ending 4242 on Oct 1, 2026. The card was declined.");
+  expect(within(screen.getByRole("table", { name: "Invoices" })).getByText("Failed")).toBeInTheDocument();
+});
+
+test("flags usage over the limit", async () => {
+  withScenario("over-limit");
+  render(<Billing />);
+  expect(await screen.findByText("Storage is over its limit", {}, { timeout: 2000 })).toBeInTheDocument();
+  expect(screen.getByText("530 of 500 GB · 30 GB over")).toBeInTheDocument();
+});
+
+test("shows empty payment method and invoices", async () => {
+  withScenario("empty");
+  render(<Billing />);
+  expect(await screen.findByText("No payment method on file", {}, { timeout: 2000 })).toBeInTheDocument();
+  expect(screen.getByText("No invoices yet")).toBeInTheDocument();
+});
+
+test("offers a retry when billing can't load", async () => {
+  withScenario("error");
+  render(<Billing />);
+  expect(await screen.findByText("Billing couldn't load", {}, { timeout: 2000 })).toBeInTheDocument();
+  withScenario();
+  fireEvent.click(screen.getByRole("button", { name: "Try again" }));
+  expect(screen.getByLabelText("Loading plan")).toBeInTheDocument();
+  expect(await screen.findByText("Team", {}, { timeout: 2000 })).toBeInTheDocument();
+});
diff --git a/src/pages/Billing.tsx b/src/pages/Billing.tsx
new file mode 100644
index 0000000..ebc094b
--- /dev/null
+++ b/src/pages/Billing.tsx
@@ -0,0 +1,147 @@
+import { useCallback, useEffect, useState } from "react";
+import { getBilling, type Billing as BillingData } from "../api/billing";
+import { Badge, Banner, Button, Card, EmptyState, Meter, Skeleton, Table, type Column, type Tone } from "../components";
+import { failureReasonText, isOverLimit, planTotal, usageFraction } from "../lib/billing";
+import { formatCardExpiry, formatDate, formatMoney, formatNumber } from "../lib/format";
+
+type State = { status: "loading" } | { status: "error" } | { status: "ready"; billing: BillingData };
+type Invoice = BillingData["invoices"][number];
+
+// Billing periods start and end on UTC boundaries in the API (Oct 1 00:00Z – Oct 31 23:59Z),
+// so dates are shown in UTC to keep the period from slipping a day in other time zones.
+const BILLING_TZ = "UTC";
+
+const invoiceStatus: Record<Invoice["status"], { label: string; tone: Tone }> = {
+  paid: { label: "Paid", tone: "success" },
+  open: { label: "Open", tone: "neutral" },
+  failed: { label: "Failed", tone: "danger" },
+};
+
+const invoiceColumns: Column<Invoice>[] = [
+  { key: "number", header: "Invoice", render: (i) => <span className="nowrap">{i.number}</span> },
+  { key: "issued", header: "Issued", render: (i) => formatDate(i.issuedAt, BILLING_TZ) },
+  { key: "amount", header: "Amount", numeric: true, render: (i) => formatMoney(i.amount) },
+  { key: "status", header: "Status", render: (i) => <Badge tone={invoiceStatus[i.status].tone}>{invoiceStatus[i.status].label}</Badge> },
+];
+
+function LoadingLines({ label }: { label: string }) {
+  return (
+    <div className="stack" aria-label={label}>
+      <Skeleton width="40%" height={20} /><Skeleton width="70%" /><Skeleton width="55%" />
+    </div>
+  );
+}
+
+function Alerts({ billing }: { billing: BillingData }) {
+  const { lastPayment, paymentMethod } = billing;
+  const over = billing.usage.filter(isOverLimit);
+  return (
+    <>
+      {lastPayment.status === "failed" && (
+        <Banner tone="danger" title="Your last payment failed">
+          We couldn't charge {formatMoney(lastPayment.amount)}
+          {paymentMethod && ` to the card ending ${paymentMethod.last4}`} on {formatDate(lastPayment.attemptedAt, BILLING_TZ)}.{" "}
+          {failureReasonText(lastPayment.failureReason)}
+        </Banner>
+      )}
+      {over.map((u) => (
+        <Banner key={u.label} tone="warning" title={`${u.label} is over its limit`}>
+          {formatNumber(u.used)} {u.unit} used of {formatNumber(u.limit)} {u.unit} this period.
+        </Banner>
+      ))}
+    </>
+  );
+}
+
+export function Billing() {
+  const [state, setState] = useState<State>({ status: "loading" });
+
+  const load = useCallback(() => {
+    setState({ status: "loading" });
+    getBilling().then(
+      (billing) => setState({ status: "ready", billing }),
+      () => setState({ status: "error" }),
+    );
+  }, []);
+
+  useEffect(load, [load]);
+
+  if (state.status === "error") {
+    return (
+      <div className="stack">
+        <h1 className="page-title">Billing</h1>
+        <Banner tone="danger" title="Billing couldn't load" action={<Button variant="secondary" onClick={load}>Try again</Button>}>
+          Check your connection and try again.
+        </Banner>
+      </div>
+    );
+  }
+
+  const billing = state.status === "ready" ? state.billing : null;
+
+  return (
+    <div className="stack">
+      <h1 className="page-title">Billing</h1>
+      {billing && <Alerts billing={billing} />}
+
+      <div className="grid-2">
+        <Card title="Plan">
+          {!billing ? <LoadingLines label="Loading plan" /> : (
+            <div className="stack-sm">
+              <p className="lead">{billing.plan.name}</p>
+              <p>
+                {formatMoney(planTotal(billing.plan))} per {billing.plan.interval}
+                <span className="text-muted"> · {billing.plan.seats} {billing.plan.seats === 1 ? "seat" : "seats"} × {formatMoney(billing.plan.pricePerSeat)}</span>
+              </p>
+              <p className="text-muted">
+                Current period: {formatDate(billing.plan.currentPeriodStart, BILLING_TZ)} – {formatDate(billing.plan.currentPeriodEnd, BILLING_TZ)}
+              </p>
+            </div>
+          )}
+        </Card>
+
+        <Card title="Payment method">
+          {!billing ? <LoadingLines label="Loading payment method" /> : billing.paymentMethod ? (
+            <div className="stack-sm">
+              <p className="lead">Card ending {billing.paymentMethod.last4}</p>
+              <p className="text-muted">
+                {billing.paymentMethod.holder} · Expires {formatCardExpiry(billing.paymentMethod.expMonth, billing.paymentMethod.expYear)}
+              </p>
+            </div>
+          ) : (
+            <EmptyState title="No payment method on file" />
+          )}
+        </Card>
+      </div>
+
+      <Card title="Usage this period">
+        {!billing ? <LoadingLines label="Loading usage" /> : billing.usage.length === 0 ? (
+          <EmptyState title="No usage to show for this period" />
+        ) : (
+          <div className="stack">
+            {billing.usage.map((u) => {
+              const over = isOverLimit(u);
+              return (
+                <Meter
+                  key={u.label}
+                  label={u.label}
+                  valueText={`${formatNumber(u.used)} of ${formatNumber(u.limit)} ${u.unit}${over ? ` · ${formatNumber(u.used - u.limit)} ${u.unit} over` : ""}`}
+                  fraction={usageFraction(u)}
+                  tone={over ? "danger" : "default"}
+                />
+              );
+            })}
+          </div>
+        )}
+      </Card>
+
+      <Card title="Invoices">
+        {!billing ? <LoadingLines label="Loading invoices" /> : billing.invoices.length === 0 ? (
+          <EmptyState title="No invoices yet">Invoices appear here once they're issued.</EmptyState>
+        ) : (
+          <Table caption="Invoices" columns={invoiceColumns} rows={billing.invoices} rowKey={(i) => i.id} />
+        )}
+      </Card>
+    </div>
+  );
+}
