+/** Pass a timeZone when the date belongs to a fixed calendar, such as a billing period set in UTC. */
+export function formatDate(iso: string, timeZone?: string): string {
+  return new Intl.DateTimeFormat(LOCALE, { year: "numeric", month: "short", day: "numeric", timeZone }).format(new Date(iso));
+}
+
+export function formatNumber(n: number): string {
+  return new Intl.NumberFormat(LOCALE).format(n);
+}
+
+/** Card expiry as printed on the card, e.g. 08/2027. */
+export function formatCardExpiry(month: number, year: number): string {
+  return `${String(month).padStart(2, "0")}/${year}`;
 }
diff --git a/src/pages/Billing.test.tsx b/src/pages/Billing.test.tsx
