--- /dev/null
+++ b/src/lib/billing.ts
@@ -0,0 +1,29 @@
+import type { Billing } from "../api/billing";
+
+type Usage = Billing["usage"][number];
+type FailureReason = NonNullable<Billing["lastPayment"]["failureReason"]>;
+
+export function planTotal(plan: Billing["plan"]): number {
+  return plan.pricePerSeat * plan.seats;
+}
+
+/** Share of the limit used, clamped to 0–1 so a bar never draws past its track. */
+export function usageFraction({ used, limit }: Usage): number {
+  if (limit <= 0) return used > 0 ? 1 : 0;
+  return Math.min(Math.max(used / limit, 0), 1);
+}
+
+// Only "over" is flagged: the API defines no warning threshold below the limit, so none is invented here.
+export function isOverLimit({ used, limit }: Usage): boolean {
+  return used > limit;
+}
+
+const FAILURE_REASONS: Record<FailureReason, string> = {
+  card_declined: "The card was declined.",
+  insufficient_funds: "The card didn't have enough funds.",
+  expired_card: "The card has expired.",
+};
+
+export function failureReasonText(reason: FailureReason | undefined): string | null {
+  return reason ? FAILURE_REASONS[reason] : null;
+}
