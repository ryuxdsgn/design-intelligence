+++ b/src/lib/billing.test.ts
@@ -0,0 +1,29 @@
+import { failureReasonText, isOverLimit, planTotal, usageFraction } from "./billing";
+
+const usage = (used: number, limit: number) => ({ label: "Storage", used, limit, unit: "GB" });
+
+test("plan total is price per seat times seats", () => {
+  const plan = { name: "Team", pricePerSeat: 1200, seats: 8, interval: "month" as const, currentPeriodStart: "", currentPeriodEnd: "" };
+  expect(planTotal(plan)).toBe(9600);
+  expect(planTotal({ ...plan, seats: 0 })).toBe(0);
+});
+
+test("usage fraction is clamped between 0 and 1", () => {
+  expect(usageFraction(usage(412, 500))).toBeCloseTo(0.824);
+  expect(usageFraction(usage(0, 500))).toBe(0);
+  expect(usageFraction(usage(530, 500))).toBe(1);
+  expect(usageFraction(usage(0, 0))).toBe(0);
+  expect(usageFraction(usage(5, 0))).toBe(1);
+});
+
+test("over limit only when used exceeds the limit", () => {
+  expect(isOverLimit(usage(500, 500))).toBe(false);
+  expect(isOverLimit(usage(501, 500))).toBe(true);
+});
+
+test("failure reasons read as plain sentences", () => {
+  expect(failureReasonText("card_declined")).toBe("The card was declined.");
+  expect(failureReasonText("insufficient_funds")).toBe("The card didn't have enough funds.");
+  expect(failureReasonText("expired_card")).toBe("The card has expired.");
+  expect(failureReasonText(undefined)).toBeNull();
+});
