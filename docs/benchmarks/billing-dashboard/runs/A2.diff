+++ b/src/components/Meter.tsx
@@ -0,0 +1,19 @@
+type Props = { label: string; value: number; max: number; valueText: string; tone?: "neutral" | "warning" | "danger" };
+
+/** A horizontal usage bar. The value may exceed max; the bar fills to 100% and the tone carries the rest. */
+export function Meter({ label, value, max, valueText, tone = "neutral" }: Props) {
+  const percent = max > 0 ? Math.min(100, (value / max) * 100) : 100;
+  return (
+    <div
+      className={`meter meter-${tone}`}
+      role="meter"
+      aria-label={label}
+      aria-valuemin={0}
+      aria-valuemax={max}
+      aria-valuenow={Math.min(value, max)}
+      aria-valuetext={valueText}
+    >
+      <div className="meter-fill" style={{ width: `${percent}%` }} />
+    </div>
+  );
+}
