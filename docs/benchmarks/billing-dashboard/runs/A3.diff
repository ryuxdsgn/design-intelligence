@@ -0,0 +1,171 @@
+import { useCallback, useEffect, useState } from "react";
+import { getBilling, type Billing as BillingData } from "../api/billing";
+import { Badge, Banner, Button, Card, EmptyState, Meter, Skeleton, Table, type Column, type Tone } from "../components";
+import { formatDate, formatMoney, formatNumber } from "../lib/format";
+
+type State = { status: "loading" } | { status: "error" } | { status: "ready"; billing: BillingData };
+type Invoice = BillingData["invoices"][number];
+type FailureReason = NonNullable<BillingData["lastPayment"]["failureReason"]>;
+
+const FAILURE_REASONS: Record<FailureReason, string> = {
+  card_declined: "the card was declined",
+  insufficient_funds: "the card had insufficient funds",
+  expired_card: "the card has expired",
+};
+
+const INVOICE_STATUS: Record<Invoice["status"], { tone: Tone; label: string }> = {
+  paid: { tone: "success", label: "Paid" },
+  open: { tone: "neutral", label: "Open" },
+  failed: { tone: "danger", label: "Failed" },
+};
+
+const invoiceColumns: Column<Invoice>[] = [
+  { key: "number", header: "Invoice", render: (i) => i.number },
+  { key: "date", header: "Date", render: (i) => formatDate(i.issuedAt) },
+  { key: "amount", header: "Amount", numeric: true, render: (i) => formatMoney(i.amount) },
+  { key: "status", header: "Status", render: (i) => <Badge tone={INVOICE_STATUS[i.status].tone}>{INVOICE_STATUS[i.status].label}</Badge> },
+];
+
+/** A card is valid through the last day of its expiry month. */
+function isExpired(card: { expMonth: number; expYear: number }, now = new Date()): boolean {
+  return now.getFullYear() * 12 + now.getMonth() + 1 > card.expYear * 12 + card.expMonth;
+}
+
+export function Billing() {
+  const [state, setState] = useState<State>({ status: "loading" });
+
+  const load = useCallback(() => {
+    setState({ status: "loading" });
+    getBilling().then(
+      (billing) => setState({ status: "ready", billing }),
+      () => setState({ status: "error" }),
+    );
+  }, []);
+
+  useEffect(load, [load]);
+
+  if (state.status === "error") {
+    return (
+      <div className="stack">
+        <h1 className="page-title">Billing</h1>
+        <Banner tone="danger" title="Billing couldn't load" action={<Button variant="secondary" onClick={load}>Try again</Button>}>
+          Check your connection and try again.
+        </Banner>
+      </div>
+    );
+  }
+
+  if (state.status === "loading") {
+    return (
+      <div className="stack" aria-busy="true">
+        <h1 className="page-title">Billing</h1>
+        <div className="grid-2">
+          <Card title="Plan"><LoadingLines label="Loading plan" /></Card>
+          <Card title="Payment method"><LoadingLines label="Loading payment method" /></Card>
+        </div>
+        <Card title="Usage this period"><LoadingLines label="Loading usage" /></Card>
+        <Card title="Invoices"><LoadingLines label="Loading invoices" /></Card>
+      </div>
+    );
+  }
+
+  const { plan, usage, paymentMethod, lastPayment, invoices } = state.billing;
+  const overLimit = usage.filter((u) => u.used > u.limit);
+  const cardExpired = paymentMethod !== null && isExpired(paymentMethod);
+
+  return (
+    <div className="stack">
+      <h1 className="page-title">Billing</h1>
+
+      {lastPayment.status === "failed" && (
+        <Banner tone="danger" title="Your last payment failed" action={<Button>Update payment method</Button>}>
+          We couldn't charge {formatMoney(lastPayment.amount)} on {formatDate(lastPayment.attemptedAt)}
+          {lastPayment.failureReason ? `: ${FAILURE_REASONS[lastPayment.failureReason]}` : ""}. Update your payment method so
+          your workspace stays active.
+        </Banner>
+      )}
+      {paymentMethod === null && (
+        <Banner tone="warning" title="No payment method on file">
+          Add a card before your plan renews on {formatDate(plan.currentPeriodEnd)}.
+        </Banner>
+      )}
+      {cardExpired && lastPayment.status !== "failed" && (
+        <Banner tone="warning" title="Your card has expired">
+          Update your card before your plan renews on {formatDate(plan.currentPeriodEnd)}.
+        </Banner>
+      )}
+      {overLimit.length > 0 && (
+        <Banner tone="warning" title="You're over your plan's limits">
+          {overLimit.map((u) => u.label).join(" and ")} {overLimit.length === 1 ? "is" : "are"} above what the {plan.name} plan
+          includes this period.
+        </Banner>
+      )}
+
+      <div className="grid-2">
+        <Card title="Plan">
+          <div className="stack-sm">
+            <p className="lead">{plan.name}</p>
+            <p className="muted">
+              {formatMoney(plan.pricePerSeat)} per seat × {plan.seats} {plan.seats === 1 ? "seat" : "seats"} ={" "}
+              {formatMoney(plan.pricePerSeat * plan.seats)} / {plan.interval}
+            </p>
+            <p className="muted">
+              Current period {formatDate(plan.currentPeriodStart)} – {formatDate(plan.currentPeriodEnd)}
+            </p>
+            <Button variant="secondary">Change plan</Button>
+          </div>
+        </Card>
+
+        <Card title="Payment method">
+          {paymentMethod ? (
+            <div className="stack-sm">
+              <p className="lead">Card ending in {paymentMethod.last4}</p>
+              <p className="muted">
+                {paymentMethod.holder} · Expires {String(paymentMethod.expMonth).padStart(2, "0")}/{paymentMethod.expYear}{" "}
+                {cardExpired && <Badge tone="danger">Expired</Badge>}
+              </p>
+              <Button variant="secondary">Update card</Button>
+            </div>
+          ) : (
+            <div className="stack-sm">
+              <p className="muted">No payment method on file.</p>
+              <Button>Add payment method</Button>
+            </div>
+          )}
+        </Card>
+      </div>
+
+      <Card title="Usage this period">
+        <div className="stack">
+          {usage.map((u) => (
+            <Meter
+              key={u.label}
+              label={u.label}
+              value={u.used}
+              max={u.limit}
+              valueText={`${formatNumber(u.used)} of ${formatNumber(u.limit)} ${u.unit}${
+                u.used > u.limit ? ` (${formatNumber(u.used - u.limit)} ${u.unit} over)` : ""
+              }`}
+            />
+          ))}
+        </div>
+      </Card>
+
+      <Card title="Invoices">
+        {invoices.length === 0 ? (
+          <EmptyState title="No invoices yet">Invoices appear here after your first payment.</EmptyState>
+        ) : (
+          <Table caption="Invoices" columns={invoiceColumns} rows={invoices} rowKey={(i) => i.id} />
+        )}
+      </Card>
+    </div>
+  );
+}
+
+function LoadingLines({ label }: { label: string }) {
+  return (
+    <div className="stack-sm" aria-label={label}>
+      <Skeleton width="50%" height={20} /><Skeleton width="70%" /><Skeleton width="40%" />
+    </div>
+  );
+}
