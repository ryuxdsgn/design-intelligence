diff --git a/src/pages/Billing.test.tsx b/src/pages/Billing.test.tsx
new file mode 100644
index 0000000..0b79fc1
--- /dev/null
+++ b/src/pages/Billing.test.tsx
@@ -0,0 +1,64 @@
+import { fireEvent, render, screen, within } from "@testing-library/react";
+import { Billing } from "./Billing";
+
+function withScenario(name?: string) {
+  window.history.replaceState({}, "", name ? `/?scenario=${name}` : "/");
+}
+
+afterEach(() => withScenario());
+
+const ready = () => screen.findByText("Team", {}, { timeout: 2000 });
+
+test("shows plan, payment method, usage, and invoices", async () => {
+  withScenario();
+  render(<Billing />);
+  await ready();
+  expect(screen.getByText(/\$12\.00 per seat × 8 seats = \$96\.00 \/ month/)).toBeInTheDocument();
+  expect(screen.getByText("Current period Oct 1, 2026 – Oct 31, 2026")).toBeInTheDocument();
+  expect(screen.getByText("Card ending in 4242")).toBeInTheDocument();
+  expect(screen.getByRole("meter", { name: "Storage" })).toHaveAttribute("aria-valuetext", "412 of 500 GB");
+  expect(screen.getByRole("meter", { name: "Automation runs" })).toHaveAttribute("aria-valuetext", "7,300 of 10,000 runs");
+  const table = screen.getByRole("table", { name: "Invoices" });
+  expect(within(table).getAllByRole("row")).toHaveLength(7);
+  expect(within(table).getByText("INV-0006")).toBeInTheDocument();
+  expect(screen.queryByRole("alert")).not.toBeInTheDocument();
+});
+
+test("shows an error with retry when billing can't load", async () => {
+  withScenario("error");
+  render(<Billing />);
+  expect(await screen.findByText("Billing couldn't load", {}, { timeout: 2000 })).toBeInTheDocument();
+  withScenario();
+  fireEvent.click(screen.getByRole("button", { name: "Try again" }));
+  expect(await ready()).toBeInTheDocument();
+});
+
+test("alerts when the last payment failed", async () => {
+  withScenario("payment-failed");
+  render(<Billing />);
+  await ready();
+  const alert = screen.getByRole("alert");
+  expect(alert).toHaveTextContent("Your last payment failed");
+  expect(alert).toHaveTextContent("We couldn't charge $96.00 on Oct 1, 2026: the card was declined.");
+  expect(within(alert).getByRole("button", { name: "Update payment method" })).toBeInTheDocument();
+  const row = screen.getByText("INV-0006").closest("tr")!;
+  expect(within(row).getByText("Failed")).toBeInTheDocument();
+});
+
+test("flags usage over the plan limit", async () => {
+  withScenario("over-limit");
+  render(<Billing />);
+  await ready();
+  expect(screen.getByText("You're over your plan's limits")).toBeInTheDocument();
+  expect(screen.getByRole("meter", { name: "Storage" })).toHaveAttribute("aria-valuetext", "530 of 500 GB (30 GB over)");
+});
+
+test("handles no payment method and no invoices", async () => {
+  withScenario("empty");
+  render(<Billing />);
+  await ready();
+  expect(screen.getByText("No payment method on file")).toBeInTheDocument();
+  expect(screen.getByRole("button", { name: "Add payment method" })).toBeInTheDocument();
+  expect(screen.getByText("No invoices yet")).toBeInTheDocument();
+  expect(screen.queryByRole("table")).not.toBeInTheDocument();
+});
diff --git a/src/pages/Billing.tsx b/src/pages/Billing.tsx
