+++ b/src/components/Meter.tsx
@@ -0,0 +1,26 @@
+type Props = { label: string; value: number; max: number; valueText: string };
+
+/** A horizontal usage bar. Turns warning at 90% and danger past the max; the bar itself is capped at full. */
+export function Meter({ label, value, max, valueText }: Props) {
+  const ratio = max > 0 ? value / max : 0;
+  const tone = ratio > 1 ? "danger" : ratio >= 0.9 ? "warning" : "neutral";
+  return (
+    <div className="meter">
+      <div className="meter-label">
+        <span>{label}</span>
+        <span className={`meter-value meter-value-${tone}`}>{valueText}</span>
+      </div>
+      <div
+        className="meter-track"
+        role="meter"
+        aria-label={label}
+        aria-valuemin={0}
+        aria-valuemax={max}
+        aria-valuenow={value}
+        aria-valuetext={valueText}
+      >
+        <div className={`meter-fill meter-fill-${tone}`} style={{ width: `${Math.min(ratio, 1) * 100}%` }} />
+      </div>
+    </div>
+  );
+}
