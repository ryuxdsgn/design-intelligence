--- /dev/null
+++ b/src/components/Meter.tsx
@@ -0,0 +1,20 @@
+type Props = { label: string; value: number; max: number; valueText: string };
+
+/** A horizontal usage bar. Turns to the danger color once value exceeds max. */
+export function Meter({ label, value, max, valueText }: Props) {
+  const over = value > max;
+  const percent = max > 0 ? Math.min(100, (value / max) * 100) : 100;
+  return (
+    <div
+      className={`meter${over ? " meter-over" : ""}`}
+      role="meter"
+      aria-label={label}
+      aria-valuemin={0}
+      aria-valuemax={max}
+      aria-valuenow={Math.min(value, max)}
+      aria-valuetext={valueText}
+    >
+      <div className="meter-fill" style={{ width: `${percent}%` }} />
+    </div>
+  );
+}
