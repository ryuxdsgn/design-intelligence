+/** A horizontal bar showing a share of a whole. Decorative: put the numbers in nearby text. */
+export function Meter({ percent, tone = "neutral" }: { percent: number; tone?: "neutral" | "danger" }) {
+  return (
+    <div className="meter" aria-hidden="true">
+      <div className={`meter-fill meter-${tone}`} style={{ width: `${percent}%` }} />
+    </div>
+  );
+}
