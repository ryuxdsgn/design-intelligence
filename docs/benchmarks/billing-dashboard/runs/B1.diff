+++ b/src/pages/Billing.test.tsx
@@ -0,0 +1,55 @@
+import { fireEvent, render, screen } from "@testing-library/react";
+import { Billing } from "./Billing";
+
+const wait = { timeout: 2000 };
+
+function withScenario(name: string) {
+  window.history.replaceState(null, "", `/?scenario=${name}`);
+}
+
+afterEach(() => window.history.replaceState(null, "", "/"));
+
+test("shows plan, payment method, usage, and invoices", async () => {
+  render(<Billing />);
+  expect(screen.getByRole("status", { name: "Loading billing" })).toBeInTheDocument();
+  expect(await screen.findByText("Team", {}, wait)).toBeInTheDocument();
+  expect(screen.getByText("Card ending in 4242")).toBeInTheDocument();
+  expect(screen.getByText("412 of 500 GB")).toBeInTheDocument();
+  expect(screen.getByText("Current period: Oct 1, 2026 – Oct 31, 2026")).toBeInTheDocument();
+  expect(screen.getByText("7,300 of 10,000 runs")).toBeInTheDocument();
+  expect(screen.getByText("INV-0006")).toBeInTheDocument();
+  expect(screen.queryByRole("alert")).not.toBeInTheDocument();
+});
+
+test("explains a failed payment", async () => {
+  withScenario("payment-failed");
+  render(<Billing />);
+  const alert = await screen.findByRole("alert", {}, wait);
+  expect(alert).toHaveTextContent("Your payment of $96.00 on Oct 1, 2026 failed");
+  expect(alert).toHaveTextContent("The card was declined. Check the card ending in 4242 with its issuer, or add a different card.");
+  expect(screen.getByText("Failed")).toBeInTheDocument();
+});
+
+test("warns when usage is over the limit", async () => {
+  withScenario("over-limit");
+  render(<Billing />);
+  expect(await screen.findByText("Storage is over the plan limit", {}, wait)).toBeInTheDocument();
+  expect(screen.getByText("530 of 500 GB · over limit")).toBeInTheDocument();
+});
+
+test("shows empty payment method and invoices", async () => {
+  withScenario("empty");
+  render(<Billing />);
+  expect(await screen.findByText("No payment method on file", {}, wait)).toBeInTheDocument();
+  expect(screen.getByText("No invoices yet")).toBeInTheDocument();
+});
+
+test("offers a retry when billing can't load", async () => {
+  withScenario("error");
+  render(<Billing />);
+  expect(await screen.findByText("Billing couldn't load", {}, wait)).toBeInTheDocument();
+  withScenario("default");
+  fireEvent.click(screen.getByRole("button", { name: "Try again" }));
+  expect(await screen.findByText("Team", {}, wait)).toBeInTheDocument();
+  expect(screen.queryByText("Billing couldn't load")).not.toBeInTheDocument();
+});
diff --git a/src/pages/Billing.tsx b/src/pages/Billing.tsx
new file mode 100644
index 0000000..1a8048a
--- /dev/null
+++ b/src/pages/Billing.tsx
@@ -0,0 +1,141 @@
+import { useCallback, useEffect, useState } from "react";
+import { getBilling, type Billing as BillingData } from "../api/billing";
+import { Badge, Banner, Button, Card, EmptyState, Meter, Skeleton, Table, type Column, type Tone } from "../components";
+import { describeFailure, isOverLimit, usageFraction } from "../lib/billing";
+import { formatDate, formatMoney, formatNumber } from "../lib/format";
+
+type State = { status: "loading" } | { status: "error" } | { status: "ready"; billing: BillingData };
+type Invoice = BillingData["invoices"][number];
+
+// Assumption: billing periods and charges follow UTC calendar days (the API's period ends at 23:59:59Z),
+// so billing dates are shown in UTC; in the viewer's zone the period would appear to end on the 1st.
+const BILLING_TZ = "UTC";
+const billingDate = (iso: string) => formatDate(iso, BILLING_TZ);
+
+const INVOICE_STATUS: Record<Invoice["status"], { label: string; tone: Tone }> = {
+  paid: { label: "Paid", tone: "success" },
+  open: { label: "Open", tone: "warning" },
+  failed: { label: "Failed", tone: "danger" },
+};
+
+const invoiceColumns: Column<Invoice>[] = [
+  { key: "number", header: "Invoice", render: (i) => i.number },
+  { key: "issued", header: "Date", render: (i) => billingDate(i.issuedAt) },
+  { key: "amount", header: "Amount", numeric: true, render: (i) => formatMoney(i.amount) },
+  { key: "status", header: "Status", render: (i) => <Badge tone={INVOICE_STATUS[i.status].tone}>{INVOICE_STATUS[i.status].label}</Badge> },
+];
+
+export function Billing() {
+  const [state, setState] = useState<State>({ status: "loading" });
+
+  const load = useCallback(() => {
+    setState({ status: "loading" });
+    getBilling().then(
+      (billing) => setState({ status: "ready", billing }),
+      () => setState({ status: "error" }),
+    );
+  }, []);
+
+  useEffect(load, [load]);
+
+  return (
+    <div className="stack">
+      <h1 className="page-title">Billing</h1>
+      {state.status === "error" && (
+        <Banner tone="danger" title="Billing couldn't load" action={<Button variant="secondary" onClick={load}>Try again</Button>}>
+          Check your connection and try again.
+        </Banner>
+      )}
+      {state.status === "loading" && <BillingSkeleton />}
+      {state.status === "ready" && <BillingDetails billing={state.billing} />}
+    </div>
+  );
+}
+
+function BillingDetails({ billing }: { billing: BillingData }) {
+  const { plan, usage, paymentMethod, lastPayment, invoices } = billing;
+  const overLimit = usage.filter((u) => isOverLimit(u.used, u.limit));
+
+  return (
+    <>
+      {lastPayment.status === "failed" && (
+        <Banner tone="danger" title={`Your payment of ${formatMoney(lastPayment.amount)} on ${billingDate(lastPayment.attemptedAt)} failed`}>
+          {describeFailure(lastPayment.failureReason)}{" "}
+          {paymentMethod ? `Check the card ending in ${paymentMethod.last4} with its issuer, or add a different card.` : "Add a payment method."}
+        </Banner>
+      )}
+      {overLimit.length > 0 && (
+        <Banner tone="warning" title={overLimit.length === 1 ? `${overLimit[0].label} is over the plan limit` : "Usage is over the plan limits"}>
+          {overLimit.map((u) => `${u.label}: ${formatNumber(u.used)} of ${formatNumber(u.limit)} ${u.unit}.`).join(" ")}
+        </Banner>
+      )}
+
+      <div className="grid-2">
+        <Card title="Plan">
+          <div className="stack-tight">
+            <p className="value-lg">{plan.name}</p>
+            <p className="tabular">{formatMoney(plan.pricePerSeat)} per seat per {plan.interval} · {plan.seats} {plan.seats === 1 ? "seat" : "seats"}</p>
+            <p className="muted tabular">Current period: {billingDate(plan.currentPeriodStart)} – {billingDate(plan.currentPeriodEnd)}</p>
+          </div>
+        </Card>
+        <Card title="Payment method">
+          {paymentMethod ? (
+            <div className="stack-tight">
+              <p className="value-lg tabular">Card ending in {paymentMethod.last4}</p>
+              <p className="muted tabular">
+                {paymentMethod.holder} · Expires {String(paymentMethod.expMonth).padStart(2, "0")}/{paymentMethod.expYear}
+              </p>
+            </div>
+          ) : (
+            <EmptyState title="No payment method on file" />
+          )}
+        </Card>
+      </div>
+
+      <Card title="Usage this period">
+        {usage.length === 0 ? (
+          <EmptyState title="No usage to show" />
+        ) : (
+          <ul className="usage-list">
+            {usage.map((u) => {
+              const over = isOverLimit(u.used, u.limit);
+              return (
+                <li key={u.label} className="stack-tight">
+                  <div className="usage-row">
+                    <span>{u.label}</span>
+                    <span className={`tabular${over ? " text-danger" : ""}`}>
+                      {formatNumber(u.used)} of {formatNumber(u.limit)} {u.unit}
+                      {over && " · over limit"}
+                    </span>
+                  </div>
+                  <Meter fraction={usageFraction(u.used, u.limit)} tone={over ? "danger" : "neutral"} />
+                </li>
+              );
+            })}
+          </ul>
+        )}
+      </Card>
+
+      <Card title="Invoices">
+        {invoices.length === 0 ? (
+          <EmptyState title="No invoices yet">Invoices will be listed here once they're issued.</EmptyState>
+        ) : (
+          <Table caption="Invoices" columns={invoiceColumns} rows={invoices} rowKey={(i) => i.id} />
+        )}
+      </Card>
+    </>
+  );
+}
+
+function BillingSkeleton() {
+  return (
+    <div className="stack" aria-label="Loading billing" role="status">
+      <div className="grid-2">
+        <Card title="Plan"><div className="stack-tight"><Skeleton width="50%" height={24} /><Skeleton width="80%" /><Skeleton width="60%" /></div></Card>
+        <Card title="Payment method"><div className="stack-tight"><Skeleton width="60%" height={24} /><Skeleton width="45%" /></div></Card>
+      </div>
+      <Card title="Usage this period"><div className="stack-tight"><Skeleton width="40%" /><Skeleton height={8} /><Skeleton width="40%" /><Skeleton height={8} /></div></Card>
+      <Card title="Invoices"><div className="stack-tight"><Skeleton /><Skeleton /><Skeleton /></div></Card>
+    </div>
+  );
+}
