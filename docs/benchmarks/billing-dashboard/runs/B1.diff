+/** A bar showing a fraction from 0 to 1. Decorative: the caller shows the numbers as text next to it. */
+export function Meter({ fraction, tone = "neutral" }: { fraction: number; tone?: "neutral" | "danger" }) {
+  return (
+    <div className={`meter meter-${tone}`} aria-hidden="true">
+      <div className="meter-fill" style={{ width: `${fraction * 100}%` }} />
+    </div>
+  );
+}
