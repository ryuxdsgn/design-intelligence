@@ -0,0 +1,24 @@
+import type { Billing } from "../api/billing";
+
+type FailureReason = NonNullable<Billing["lastPayment"]["failureReason"]>;
+
+/** Share of the limit used, clamped to 0..1 for drawing a bar. Over-limit usage draws a full bar. */
+export function usageFraction(used: number, limit: number): number {
+  if (limit <= 0) return used > 0 ? 1 : 0;
+  return Math.min(Math.max(used / limit, 0), 1);
+}
+
+export function isOverLimit(used: number, limit: number): boolean {
+  return used > limit;
+}
+
+const FAILURE_REASONS: Record<FailureReason, string> = {
+  card_declined: "The card was declined.",
+  insufficient_funds: "The card didn't have enough funds.",
+  expired_card: "The card has expired.",
+};
+
+/** The API may omit the reason, so fall back to a sentence that doesn't guess one. */
+export function describeFailure(reason: FailureReason | undefined): string {
+  return reason ? FAILURE_REASONS[reason] : "The card issuer didn't give a reason.";
+}
