@@ -0,0 +1,27 @@
+import { describeFailure, isOverLimit, usageFraction } from "./billing";
+
+test("usageFraction is the share of the limit used", () => {
+  expect(usageFraction(250, 500)).toBe(0.5);
+  expect(usageFraction(0, 500)).toBe(0);
+  expect(usageFraction(500, 500)).toBe(1);
+});
+
+test("usageFraction clamps over-limit and odd input", () => {
+  expect(usageFraction(530, 500)).toBe(1);
+  expect(usageFraction(-5, 500)).toBe(0);
+  expect(usageFraction(0, 0)).toBe(0);
+  expect(usageFraction(3, 0)).toBe(1);
+});
+
+test("isOverLimit only when usage passes the limit", () => {
+  expect(isOverLimit(500, 500)).toBe(false);
+  expect(isOverLimit(501, 500)).toBe(true);
+  expect(isOverLimit(499, 500)).toBe(false);
+});
+
+test("describeFailure explains each reason and handles a missing one", () => {
+  expect(describeFailure("card_declined")).toBe("The card was declined.");
+  expect(describeFailure("insufficient_funds")).toBe("The card didn't have enough funds.");
+  expect(describeFailure("expired_card")).toBe("The card has expired.");
+  expect(describeFailure(undefined)).toBe("The card issuer didn't give a reason.");
+});
