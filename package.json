{
  "name": "ryux",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev:mcp": "pnpm --filter @ryux/mcp dev",
    "deploy:mcp": "pnpm --filter @ryux/mcp deploy",
    "dev:web": "pnpm --filter @ryux/web dev",
    "build:web": "pnpm --filter @ryux/web build",
    "sync:skills": "pnpm --filter @ryuxdsgn/ryux build && node packages/cli/scripts/sync-skills.mjs",
    "typecheck": "pnpm -r typecheck"
  }
}
